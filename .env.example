# Copy this file's variables into Vercel: Project -> Settings -> Environment Variables.
# Never commit real values to git.

# From your SSLCommerz sandbox merchant panel (https://developer.sslcommerz.com/registration/)
SSLCOMMERZ_STORE_ID=your_sandbox_store_id
SSLCOMMERZ_STORE_PASSWORD=your_sandbox_store_password

# Keep as false for the sandbox gateway. Set to true only once you have LIVE
# SSLCommerz credentials and are ready to accept real payments.
SSLCOMMERZ_IS_LIVE=false
